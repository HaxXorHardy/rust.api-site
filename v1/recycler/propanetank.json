{"data":{"description":"Empty Propane Tank is a crafting component used in 5 recipes: the Propane Explosive Bomb, Flame Thrower, [Flame Turret](/items/flame-turret), Speargun and [Water Purifier](/items/water-purifier). To craft a propane tank, research it for 40 scrap, then use a tier 2 workbench with 100 frags and 10 scrap. Tanks also drop from underwater crates, Scarecrows, Gingerbread and [tunnel dwellers](/world/tunnel-dweller), plus yellow and blue barrels at around 8%. Recycling one in a Green Recycler gives 50 frags and 1 scrap.","item":{"id":"propanetank","name":"Empty Propane Tank","path":"/v1/items/empty-propane-tank.json","slug":"empty-propane-tank"},"name":"Empty Propane Tank","path":"/v1/recycler/propanetank.json","recyclers":[{"guaranteed":[{"amount":1,"item":{"id":"scrap","name":"Scrap","path":"/v1/items/scrap.json","slug":"scrap"}},{"amount":75,"item":{"id":"metal-fragments","name":"Metal Fragments","path":"/v1/items/metal-fragments.json","slug":"metal-fragments"}}],"recycler":{"id":"recycler-red","name":"Red Recycler","path":"/v1/world/recycler-red.json","slug":"recycler-red"}},{"guaranteed":[{"amount":1,"item":{"id":"scrap","name":"Scrap","path":"/v1/items/scrap.json","slug":"scrap"}},{"amount":60,"item":{"id":"metal-fragments","name":"Metal Fragments","path":"/v1/items/metal-fragments.json","slug":"metal-fragments"}}],"recycler":{"id":"recycler-green-powered","name":"Green Recycler (powered)","path":"/v1/world/recycler-green-powered.json","slug":"recycler-green-powered"}},{"guaranteed":[{"amount":1,"item":{"id":"scrap","name":"Scrap","path":"/v1/items/scrap.json","slug":"scrap"}},{"amount":50,"item":{"id":"metal-fragments","name":"Metal Fragments","path":"/v1/items/metal-fragments.json","slug":"metal-fragments"}}],"recycler":{"id":"recycler-green","name":"Green Recycler","path":"/v1/world/recycler-green.json","slug":"recycler-green"}},{"guaranteed":[{"amount":40,"item":{"id":"metal-fragments","name":"Metal Fragments","path":"/v1/items/metal-fragm