{"data":{"categories":["items/resources"],"category":"Resources","consumable":false,"craftable":false,"deployable":false,"description":"The Beehive Nucleus is the heart of a hive, the thing you slot into a [beehive](/items/beehive) to raise bees, and happy bees grow it for bigger [honeycomb](/items/honeycomb) yields. To get a bee nucleus, use Extract on honeycomb: each comb has a 10% chance to drop one, otherwise you get honey. Natural beehives drop 4-6 honeycomb. It's used in 1 recipe, the Bee Grenade, and recycling that grenade in a Green Recycler has a 50% chance to return the nucleus.","despawnSeconds":1200,"extras":{"baitInfo":{"baitValue":2,"maxBaitStack":0},"translationKeys":{"description":"game@nucleus.desc","name":"game@nucleus"}},"flags":["canBeObtainedByRecycling","canObtainedFrom","isBait","isUsedForCrafting"],"hasSkins":false,"iconUrl":"https://cdn.rusthelp.com/images/public/nucleus.png","id":"nucleus","ingameId":-1811234677,"introduction":{"publishedAt":"2025-03-06T00:00:00.000Z","title":"Crafting Update","url":"https://rust.facepunch.com/news/crafting-update"},"links":{"items":[{"id":"beehive","name":"Beehive","path":"/v1/items/beehive.json","slug":"beehive"},{"id":"honeycomb","name":"Honeycomb","path":"/v1/items/honeycomb.json","slug":"honeycomb"}]},"maxCondition":0,"meta":{"catalogRustItemId":-1811234677,"contentHash":"8b58b1d315ef40ce","sourceUrl":"https://rusthelp.com/items/beehive-nucleus"},"name":"Beehive Nucleus","obtainedFrom":[{"entity":{"id":"honeycomb","name":"Honeycomb","path":"/v1/items/honeycomb.json","slug":"honeycomb"},"max":0.1,"min":0.1}],"path":"/v1/items/beehive-nucleus.json","recyclable":false,"recycledFrom":[{"amount":75,"item":{"id":"grenade-bee","name":"Bee Grenade","path":"/v1/items/bee-grenade.json","slug":"bee-grenade"}}],"sections":["obtaining","recycledFrom","reciprocalCraft","baitInfo"],"shortName":"nucleus","slug":"beehive-nucleus","stackSize":1,"tabs":[{"label":"Obtained from","section":"obtaining"},{"label":"Recycled F